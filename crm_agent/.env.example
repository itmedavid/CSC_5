# Copy to .env and fill in values. .env is gitignored.

# Which LLM provider to use: "anthropic" (default), "openai", or "mock".
LLM_PROVIDER=anthropic

# Anthropic (primary)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (parity)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Defaults shown in the UI; can be overridden per session in the sidebar.
DEFAULT_INITIALS=DB
AUTO_MATCH_THRESHOLD=90
REVIEW_THRESHOLD=70

# Storage paths (relative to crm_agent/).
DB_PATH=data/store_database.db
EXPORTS_DIR=exports
LOGS_DIR=logs

# Used to default the date on a parsed note when no date is detected.
TIMEZONE=America/Los_Angeles

# LLM call tuning.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
ENABLE_PROMPT_CACHE=true

# RingCentral integration (M2). "mock" reads tests/fixtures/sample_calls.json;
# "live" hits the real API (requires JWT auth + the `ringcentral` SDK).
RINGCENTRAL_MODE=mock
RINGCENTRAL_FIXTURE_PATH=tests/fixtures/sample_calls.json
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_SERVER_URL=https://platform.ringcentral.com
RINGCENTRAL_JWT=

# Outlook / Microsoft Graph integration (M3). "mock" reads
# tests/fixtures/sample_recaps.json; "live" hits Microsoft Graph (requires
# Azure AD app registration with Mail.Read).
OUTLOOK_MODE=mock
OUTLOOK_FIXTURE_PATH=tests/fixtures/sample_recaps.json
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# Recap summarizer (M3). Long transcripts above this char count are
# condensed via the LLM before reaching the note formatter.
RECAP_SUMMARIZE_CHAR_THRESHOLD=1500
RECAP_MAX_TOKENS=600

# GuideCX browser-paste integration (M4). Default is "dry_run" (no browser).
# Switch to "live" only after wiring the Playwright client and setting all
# the GUIDECX_*_SELECTOR vars.
GUIDECX_MODE=dry_run
GUIDECX_PROJECT_URL_TEMPLATE=https://app.guidecx.com/projects/{project_id}
GUIDECX_USER_DATA_DIR=
GUIDECX_HEADLESS=false
GUIDECX_NOTES_TAB_SELECTOR=
GUIDECX_NOTE_TEXTAREA_SELECTOR=
GUIDECX_SAVE_BUTTON_SELECTOR=
